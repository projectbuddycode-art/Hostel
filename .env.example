# Application
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Staff account created by prisma/seed.ts. Never commit real production values.
# Leave blank in production and create the first administrator through a controlled secret store.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Development only. Ignored when NODE_ENV=production.
# When true, the forgot-password action returns the reset path so local accounts can be recovered without SMTP.
DEV_EXPOSE_RESET_LINKS="false"

# Public correspondence. Leave blank rather than publishing an address you do not control.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# Razorpay. Subscriptions activate only after a verified payment or an authorised offline record.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# WhatsApp Cloud API. Messages are sent only with a template name and a customer opt-in.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_REGISTRATION=""
WHATSAPP_TEMPLATE_SUBSCRIPTION=""
WHATSAPP_TEMPLATE_MEAL=""
WHATSAPP_TEMPLATE_ORDER=""
WHATSAPP_TEMPLATE_DELIVERY=""
WHATSAPP_TEMPLATE_PAYMENT=""
WHATSAPP_TEMPLATE_RENEWAL=""
